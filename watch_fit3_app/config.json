{
  "app": {
    "bundleName": "com.teleprompter.fit3",
    "vendor": "teleprompter",
    "version": {
      "code": 1,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {
    "default": {
      "keepAlive": true
    }
  },
  "module": {
    "package": "com.teleprompter.fit3.entry",
    "name": ".entry",
    "deviceType": [
      "wearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "name": "default",
        "icon": "$media:icon",
        "description": "Smartwatch Teleprompter para Huawei Watch Fit 3",
        "label": "Teleprompter",
        "type": "page"
      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index"
        ],
        "name": "default",
        "window": {
          "designWidth": 402,
          "autoDesignWidth": false
        }
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "Alerta háptica al cambiar de diapositiva",
        "usedScene": {
          "ability": [
            "default"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
